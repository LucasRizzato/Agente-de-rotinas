# ══════════════════════════════════════════════════════════════
#  As três seções abaixo são só do Guardião (agente do Obsidian).
#  O Agente Financeiro NÃO usa nenhuma delas — se você só usa o
#  agente financeiro, pode deixar tudo isso em branco.
# ══════════════════════════════════════════════════════════════

# ── Vault ──────────────────────────────────────────────────────
OBSIDIAN_VAULT_PATH=C:\Guardião

# ── Claude (Anthropic) ─────────────────────────────────────────
# Obtenha em: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# ── Telegram Bot ───────────────────────────────────────────────
# 1. Abra o Telegram e fale com @BotFather
# 2. Envie /newbot, escolha um nome e um username (ex: guardiao_bot)
# 3. Cole o token abaixo
TELEGRAM_BOT_TOKEN=123456789:AAF...

# 4. Rode "python bot.py", mande /start para o bot
# 5. Cole aqui o Chat ID que ele exibir
TELEGRAM_CHAT_ID=987654321


# ══════════════════════════════════════════════════════════════
#  Daqui para baixo é o que o Agente Financeiro realmente usa.
# ══════════════════════════════════════════════════════════════

# ── Agente Financeiro Perinity (Gmail) ────────────────────────────────
# 1. No Google Cloud Console (console.cloud.google.com), crie um projeto,
#    ative a "Gmail API" e crie uma credencial OAuth "App para Computador".
# 2. Baixe o JSON gerado e salve como credentials.json (ou aponte o caminho
#    abaixo). Na primeira execução o navegador vai pedir login/consentimento
#    e um token.json será criado automaticamente.
GMAIL_CREDENTIALS_PATH=credentials.json
GMAIL_TOKEN_PATH=token.json

# Endereços monitorados (podem ser aliases do mesmo Gmail/Workspace)
PJ_INBOX_ADDRESS=nfefopag@perinity.com
FORNECEDOR_INBOX_ADDRESS=financeiro@perinity.com

# Pastas onde as notas/boletos serão salvos, organizadas por mês
PJ_NOTAS_BASE_PATH=C:\Users\lucas\OneDrive\Área de Trabalho\Financeiro_Perinity\10. Notas fiscais\Pagamento fornecedores PJs
FORNECEDOR_NOTAS_BASE_PATH=C:\Users\lucas\OneDrive\Área de Trabalho\Financeiro_Perinity\10. Notas fiscais\Pagamentos fornecedores (Suprimentos)

# Planilha de controle única (colaboradores PJ e fornecedores, separados
# pela coluna "Categoria"). Criada automaticamente se não existir.
CONTROL_SHEET_PATH=C:\Users\lucas\OneDrive\Área de Trabalho\Financeiro_Perinity\10. Notas fiscais\Controle_Notas_Fiscais.xlsx

# Quantidade máxima de e-mails novos processados por execução, por rotina
GMAIL_MAX_RESULTS=50
